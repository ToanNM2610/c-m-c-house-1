// ============================================================================
// 2. PageConfig (7 rows — one per public page)
// ============================================================================
model PageConfig {
  id         String   @id @default(cuid())
  pageKey    String   @unique // 'home' | 'about' | 'space' | 'menu' | 'reviews' | 'news' | 'contact'
  enabled    Boolean  @default(true)
  seoTitleVi String
  seoTitleEn String
  seoDescVi  String
  seoDescEn  String
  sections   Json
  updatedAt  DateTime @updatedAt
}

