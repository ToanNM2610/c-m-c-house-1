// ============================================================================
// 6. ReservationInquiry (Đặt bàn, Tiệc BBQ & Liên hệ)
// ============================================================================
enum InquiryType {
  TABLE
  BBQ
  CONTACT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
}

model ReservationInquiry {
  id         String        @id @default(cuid())
  type       InquiryType   @default(CONTACT)
  fullName   String
  phone      String
  email      String?
  date       String?
  time       String?
  guestCount Int?
  message    String
  status     InquiryStatus @default(NEW)
  adminNote  String?
  ipAddress  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model ContactSubmission {
  id          String    @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  subject     String?   @default("Tư vấn chung")
  message     String
  status      String    @default("NEW")
  emailStatus String    @default("NOT_CONFIGURED")
  emailSentTo String?
  emailError  String?
  repliedAt   DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================================
// 7. CustomerReview (Đánh giá khách hàng)
// ============================================================================
enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model CustomerReview {
  id         String       @id @default(cuid())
  authorName String
  rating     Int          @default(5)
  contentVi  String
  contentEn  String?
  replyVi    String?
  replyEn    String?
  status     ReviewStatus @default(PENDING)
  isFeatured Boolean      @default(false)
  visitDate  String?
  ipAddress  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, isFeatured, createdAt])
}

model GuestComment {
  id          String   @id @default(cuid())
  authorName  String
  rating      Int      @default(5)
  content     String
  visitDate   String?
  status      String   @default("PENDING")
  isFeatured  Boolean  @default(false)
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// 8. RedirectRule (Chuyển hướng 301/302)
// ============================================================================
model RedirectRule {
  id          String   @id @default(cuid())
  fromPath    String?
  sourcePath  String?  @unique
  toPath      String?
  targetPath  String?
  statusCode  Int      @default(301)
  isActive    Boolean  @default(true)
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// 9. AdminUser, AdminSession, AuditLog
// ============================================================================
enum AdminRole {
  SUPER_ADMIN
  EDITOR
  STAFF
}

model AdminUser {
  id                String         @id @default(cuid())
  username          String         @unique
  passwordHash      String
  fullName          String
  role              String         @default("EDITOR")
  isActive          Boolean        @default(true)
  totpSecret        String?
  totpEnabled       Boolean        @default(false)
  totpRecoveryCodes String?
  lastLoginAt       DateTime?
  sessions          AdminSession[]
  auditLogs         AuditLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model AdminSession {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        String     @id @default(cuid())
  action    String
  module    String
  recordId  String?
  details   String?
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String?
  ipAddress String?
  createdAt DateTime   @default(now())

  @@index([module, createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  folder    String   @default("gallery")
  filename  String
  fileType  String   @default("image/webp")
  fileSize  Int      @default(0)
  altVi     String?  @default("")
  altEn     String?  @default("")
  createdAt DateTime @default(now())
}

model PageSeo {
  id            String   @id @default(cuid())
  route         String   @unique
  metaTitleVi   String
  metaTitleEn   String?
  metaDescVi    String
  metaDescEn    String?
  h1Vi          String?
  h1En          String?
  ogImage       String?
  canonicalUrl  String?
  noIndex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model GmailConfig {
  id               String   @id @default("default")
  isEnabled        Boolean  @default(true)
  senderName       String   @default("Cẩm Cù House — Thông Báo Website")
  senderEmail      String   @default("")
  appPassword      String   @default("")
  autoReplyEnabled Boolean  @default(false)
  autoReplySubject String   @default("Cẩm Cù House đã nhận được lời nhắn của bạn")
  autoReplyBody    String   @default("Cảm ơn bạn đã liên hệ Cẩm Cù House. Chúng tôi đã ghi nhận thông tin và sẽ phản hồi sớm nhất.")
