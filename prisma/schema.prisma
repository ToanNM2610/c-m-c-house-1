// ============================================================================
// 3. MenuCategory & MenuItem (7 categories + ~67 items)
// ============================================================================
model MenuCategory {
  id         String     @id
  nameVi     String
  nameEn     String
  slug       String     @unique
  sortOrder  Int        @default(0)
  orderIndex Int        @default(0)
  items      MenuItem[]
}

model MenuItem {
  id              String        @id
  categoryId      String
  category        MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)
  orderIndex      Int           @default(0)
  nameVi          String
  nameEn          String?
  name            String?
  vietnameseTitle String?
  descVi          String        @default("")
  descEn          String?       @default("")
  description     String?       @default("")
  descriptionEn   String?       @default("")
  priceVnd          Int             @default(25000)
  salePriceVnd      Int?
  costPriceVnd      Int             @default(0)
  price             Float           @default(25000)
  priceDisplay      String?
  originRegion      String?
  tastingNotes      String?
  servingSize       String?
  imageUrl          String?
  photoUrl          String?
  variants          String?
  variantsEn        String?
  isFeatured        Boolean         @default(false)
  isAvailable       Boolean         @default(true) // 'Còn món / Tạm hết' toggle (display only)
  inStock           Boolean         @default(true)
  isVisible         Boolean         @default(true) // 'Hiển thị / Ẩn'
  badgeVi           String?
  badgeEn           String?
  highlight         String?
  highlightEn       String?
  editorialNoteVi   String?
  editorialNoteEn   String?
  editorialNote     String?
  moodTags          String?
  modelType         String?
  customGlbUrl      String?
  ingredients       String?
  orderCount        Int             @default(0)
  sku               String?
  productType       String          @default("DRINK_FOOD")
  trackInventory    Boolean         @default(false)
  stockQuantity     Int             @default(0)
  stockReserved     Int             @default(0)
  lowStockThreshold Int             @default(5)
  allowOrdering     Boolean         @default(true)
  optionGroups      Json?
  variantsList      ProductVariant[]
  stockMovements    StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([categoryId, sortOrder])
}

model ProductVariant {
  id           String   @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  nameVi       String
  nameEn       String?
  sku          String?
  priceVnd     Int
  salePriceVnd Int?
  stockOnHand  Int      @default(0)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StockMovement {
  id            String   @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  type          String   // 'IN' | 'OUT' | 'RESERVE' | 'RELEASE' | 'ADJUST'
  quantity      Int
  beforeQty     Int      @default(0)
  afterQty      Int      @default(0)
  note          String?
  referenceId   String?
  actorUsername String?
  createdAt     DateTime @default(now())

  @@index([menuItemId, createdAt])
}

