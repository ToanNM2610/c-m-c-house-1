  description     String
  descriptionEn   String?
  price           Float
  priceDisplay    String?
  variants        String?       // JSON array of MenuItemVariant [{ id, name, price }]
  variantsEn      String?       // JSON array of MenuItemVariant [{ id, name, price }]
