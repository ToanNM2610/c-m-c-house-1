datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model StoreSettings {
  id              String   @id @default("default")
  name            String
  tagline         String
  taglineEn       String   @default("Botanical Eco-Coffee & Streamside Sanctuary")
  address         String
  addressEn       String   @default("Alley 437 Hung Vuong, Dong Gia Nghia, Lam Dong")
  hotlines        String   // JSON array of strings
  email           String
  monThuHours     String
  monThuHoursEn   String   @default("Mon – Thu: 07:00 – 18:00")
  friSunHours     String
  friSunHoursEn   String   @default("Fri – Sun: 07:00 – 22:00")
  timezone        String   @default("Asia/Ho_Chi_Minh")
  socialProof     String
  socialProofEn   String   @default("100% Recommended (Based on 8/8 customer reviews)")
  googleMapsUrl   String
  facebookUrl     String
  tiktokUrl       String
  youtubeUrl      String
  announcement    String
  announcementEn  String   @default("Acoustic live music by the stream every Saturday evening (19:30 - 21:30)")
  footerDesc      String   @default("Cà phê sinh thái bên bờ suối — Xanh sạch, trong lành, hòa mình với thiên nhiên giữa lòng Đông Gia Nghĩa, Lâm Đồng. Thức uống thảo mộc và cà phê rang mộc.")
  footerDescEn    String   @default("Eco-coffee sanctuary nestled beside a natural stream in Dong Gia Nghia, Lam Dong. Wood-roasted coffee, fresh herbal teas, and tranquil rainforest canopy.")
  defaultLanguage String   @default("vi") // "vi" | "en"
  defaultTheme    String   @default("light") // "light" | "dark" | "auto"
  fontPreset      String   @default("sans-be-vietnam") // "sans-be-vietnam" | "sans-jakarta" | "sans-inter" | "serif-editorial"
  lightBgHex      String   @default("#F6F3EC")
  lightAccentHex  String   @default("#2E5A3C")
  darkBgHex       String   @default("#111915")
  darkAccentHex   String   @default("#4C9A67")
  enableAnimations Boolean @default(true)
  motionIntensity  String  @default("VIVID") // "OFF" | "SUBTLE" | "VIVID"

  // Marketing & Tracking Integration (Module 4)
  gaMeasurementId String?  @default("") // Google Analytics 4 (e.g. G-XXXXX)
  gtmContainerId  String?  @default("") // Google Tag Manager (e.g. GTM-XXXXX)
  gscVerification String?  @default("") // Google Search Console verification meta tag
  facebookPixelId String?  @default("") // Facebook Meta Pixel ID
  tiktokPixelId   String?  @default("") // TikTok Pixel ID

  // Floating Quick-Chat & Contact Integration (Module 4)
  enableQuickChat Boolean  @default(true)
  zaloUrl         String?  @default("https://zalo.me/0382851688")
  messengerUrl    String?  @default("https://m.me/camcuhousedaknong")
  quickChatPhone  String?  @default("0382851688")
  enableSocialShare Boolean @default(true)
  whatsappUrl     String?  @default("https://wa.me/84382851688")
  instagramUrl    String?  @default("https://instagram.com/camcuhousedaknong")
  usdExchangeRate Int?     @default(25000)

  // Cinematic Intro Overlay Configuration (120fps)
  enableIntro     Boolean  @default(true)
  introFrequency  String   @default("SESSION") // "SESSION" | "ALWAYS"
  introEyebrowVi  String   @default("ĐÔNG GIA NGHĨA • LÂM ĐỒNG • HẺM 437 HÙNG VƯƠNG")
  introEyebrowEn  String   @default("DONG GIA NGHIA • LAM DONG • ALLEY 437 HUNG VUONG")
  introSubtitleVi String   @default("Cà phê sinh thái bên bờ suối — Xanh sạch & Trong lành")
  introSubtitleEn String   @default("Streamside Ecological Café — Clean & Lush Sanctuary")

  // Review Showcase Configuration (Module 4)
  reviewDisplayMode    String   @default("AUTO_RANDOM") // "AUTO_RANDOM" | "MANUAL"
  reviewAutoIntervalSec Int     @default(6)

  // Section visibility toggles (Module 3 - Admin ON/OFF)
  showEventsSection   Boolean  @default(true)  // Controls "Các Hoạt Động Đang Diễn Ra"
  showHighlightsSection Boolean @default(true) // Controls "Nhịp Sống Tự Nhiên Bên Dòng Suối"

  updatedAt       DateTime @updatedAt
}

model SiteContent {
  id                      String   @id @default("default")
  // Hero Section
  heroEyebrow             String   @default("BOTANICAL ECO-COFFEE & STREAMSIDE SANCTUARY")
  heroEyebrowEn           String   @default("BOTANICAL ECO-COFFEE & STREAMSIDE SANCTUARY")
  heroTitle               String   @default("CẨM CÙ HOUSE")
  heroTitleEn             String   @default("CẨM CÙ HOUSE")
  heroSubtitle            String   @default("Bên Dòng Suối Mát • Hẻm 437 Hùng Vương, Đông Gia Nghĩa, Lâm Đồng")
  heroSubtitleEn          String   @default("Beside Fresh Mountain Stream • Alley 437 Hung Vuong, Dong Gia Nghia, Lam Dong")
  heroTagline             String   @default("Cà phê sinh thái bên bờ suối — Xanh sạch, trong lành, hòa mình với thiên nhiên giữa lòng Đông Gia Nghĩa, Lâm Đồng.")
  heroTaglineEn           String   @default("Eco-coffee sanctuary beside a natural stream — Fresh, serene, and harmonized with rainforest nature in the heart of Dong Gia Nghia, Lam Dong.")
  heroDescription         String   @default("Tận hưởng không gian suối mát rượi quanh năm, view suối tự nhiên, hương vị cà phê muối đậm đà rang mộc bazan Đăk Nông cùng các thức uống thảo mộc lành sạch cho tâm hồn.")
  heroDescriptionEn       String   @default("Experience year-round cool streamside breezes, natural waterfall views, authentic wood-roasted Dak Nong basalt coffee, and wholesome botanical herbal drinks for peace of mind.")
  showHero3DBean          Boolean  @default(true)

  // Philosophy & Sanctuary Preview Section
  philosophyEyebrow       String   @default("VỀ KHÔNG GIAN BÊN SUỐI")
  philosophyEyebrowEn     String   @default("ABOUT OUR STREAMSIDE SANCTUARY")
  philosophyTitle         String   @default("Nơi Nhịp Thở Chậm Lại Bên Dòng Suối Tự Nhiên")
  philosophyTitleEn       String   @default("Where Your Breath Slows Down by the Gentle Stream")
  philosophyLead          String   @default("Giữa lòng Đông Gia Nghĩa, Lâm Đồng, Cẩm Cù House ẩn mình dưới con dốc rợp bóng cây tại Hẻm 437 Hùng Vương, nép mình bên dòng suối nhỏ chảy róc rách bốn mùa.")
  philosophyLeadEn        String   @default("In the heart of Dong Gia Nghia, Lam Dong, Cẩm Cù House is nestled down a tree-shaded slope at Alley 437 Hung Vuong, sitting peacefully along a gentle natural stream flowing year-round.")
  philosophyStory         String   @default("Chúng tôi giữ lại nguyên vẹn nét hoang sơ của ghềnh đá, tán cây rừng và làn hơi nước mát lạnh để tạo nên một chốn dừng chân thanh sạch, bình yên đúng nghĩa cho bạn và người thương.")
  philosophyStoryEn       String   @default("We preserve the pristine basalt rocks, rainforest canopy, and cool water mists to create a truly pure, serene haven for you and your loved ones.")
  philosophyCards         String   // JSON array of { title, desc, iconName }
  philosophyCardsEn       String?  // JSON array of { title, desc, iconName }

  // Page 1 Home Featured Section Toggles
  showFeaturedMenu        Boolean  @default(true)
  showFeaturedSpace       Boolean  @default(true)
  showFeaturedReviews     Boolean  @default(true)
  showFeaturedEvents      Boolean  @default(true)

  // Brand Story & About Us (/gioi-thieu) Section
  brandStoryTitle         String   @default("Hành Trình Khởi Sinh Dưới Vòm Hoa Cẩm Cù")
  brandStoryTitleEn       String   @default("The Awakening Journey Beneath the Wax Plant Vines")
  brandStorySubtitle      String   @default("Câu Chuyện Về Đất Đỏ Bazan, Con Suối Nhỏ & Giọt Cà Phê Mộc")
  brandStorySubtitleEn    String   @default("A Story of Basalt Soil, Gentle Streams & Pure Wood-Roasted Coffee")
  brandStoryContent       String   @default("Đông Gia Nghĩa, Lâm Đồng không chỉ có thiên nhiên xanh mát mà còn có những thung lũng xanh tĩnh lặng ẩn mình. Cẩm Cù House được sinh ra từ chính niềm say mê thiên nhiên và khát khao gìn giữ một khoảng trời xanh trong lành giữa lòng Đông Gia Nghĩa. Từng giàn lan Cẩm Cù bung nở những chùm hoa hình ngôi sao sáp dịu dàng soi bóng xuống dòng nước suối trong veo.")
  brandStoryContentEn     String   @default("Dong Gia Nghia, Lam Dong is blessed with pristine waterfalls and serene green valleys. Cẩm Cù House was born from our profound love for nature and a dream to preserve an untamed green haven in Dong Gia Nghia. Star-shaped porcelain wax flowers bloom gracefully over the crystal-clear streams.")
  brandStoryPhilosophy    String   @default("Triết lý của chúng tôi rất giản dị: 'Xanh - Lành - Thuần Khiết'. Mỗi ly cà phê mộc là hương vị của đất bazan núi lửa, mỗi ấm trà thảo mộc là sự chắt chiu từ hoa lá vườn nhà. Không gian ở đây không có máy lạnh ngột ngạt hay tiếng còi xe, chỉ có gió ngàn, tiếng suối reo và tiếng cười của những buổi chuyện trò ấm cúng.")
  brandStoryPhilosophyEn  String   @default("Our philosophy is simple: 'Green - Wholesome - Pure'. Every cup of wood-roasted coffee carries the volcanic richness of basalt soil; every herbal teapot is carefully harvested from home garden botanicals. No noisy air conditioners or traffic honks—only mountain breeze, babbling water, and warm laughter.")
  brandStoryImageUrl      String?
  showStoryMilestones     Boolean  @default(true)
  showTeamMembers         Boolean  @default(true)

