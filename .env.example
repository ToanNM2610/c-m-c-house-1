# ==============================================================================
# CẨM CÙ HOUSE — BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Hệ thống Website Hoàn Chỉnh: camcuhouse.online | admin.camcuhouse.online
# ==============================================================================

# 1. Cơ Sở Dữ Liệu (Neon Postgres qua Drizzle ORM)
DATABASE_URL=postgres://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/camcu_db?sslmode=require

# 2. Khóa Mã Hóa Bảo Mật Tích Hợp (AES-256-GCM)
# Biến APP_ENCRYPTION_KEY duy nhất ở Vercel (đặt một lần, không đổi, dùng mã hóa các khóa bí mật trong integration_settings)
APP_ENCRYPTION_KEY=camcu_house_aes_256_master_key_random_64_hex_characters_here
AUTH_SECRET=your_super_secret_auth_key_at_least_32_characters_long
TOTP_ENCRYPTION_KEY=your_totp_encryption_secret_key_32_chars

# 3. Biến Môi Trường Tích Hợp Dự Phòng (Ưu tiên đọc trực tiếp từ DB /admin/integrations)
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_PROPERTY_ID=456789123

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token-here
SEARCH_CONSOLE_PROPERTY=sc-domain:camcuhouse.online

# Google Service Account JSON (dùng cho Analytics Data API + Search Console API)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Places & Maps
GOOGLE_PLACES_API_KEY=AIzaSyYourGooglePlacesAPIKeyHere
GOOGLE_PLACE_ID=ChIJW9cIF37-czERpYzfAXjLt8M
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# 4. Bảo Vệ Endpoint Cron Tự Động
CRON_SECRET=your_random_secure_cron_secret_token

# 5. Lưu Trữ Hình Ảnh (Vercel Blob Storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_read_write_token_here

# 6. Quan Sát & Đo Lường (Sentry & Vercel Analytics)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 7. Môi Trường Chạy
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://camcuhouse.online
NEXT_PUBLIC_ADMIN_URL=https://admin.camcuhouse.online
