# ==============================================================================
# CẨM CÙ HOUSE — BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Hệ thống Website Hoàn Chỉnh: camcuhouse.online | admin.camcuhouse.online
# ==============================================================================

# 1. Cơ Sở Dữ Liệu (Neon Postgres qua Drizzle ORM)
# Chuỗi kết nối Postgres Neon Serverless có SSL
DATABASE_URL=postgres://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/camcu_db?sslmode=require

# 2. Xác Thực & Bảo Mật Admin (Auth.js & TOTP 2FA)
# Khóa bí mật sinh bằng: openssl rand -base64 32
AUTH_SECRET=your_super_secret_auth_key_at_least_32_characters_long
# Mã PIN mặc định khởi tạo ban đầu (chủ quán có thể đổi trong giao diện admin)
ADMIN_DEFAULT_PIN=2610
# Khóa bí mật mã hóa TOTP secret lưu trữ
TOTP_ENCRYPTION_KEY=your_totp_encryption_secret_key_32_chars

# 3. Đồng Bộ Đánh Giá Google Places (Place Details API)
# API key tạo tại Google Cloud Console, bật Places API (New/Details)
GOOGLE_PLACES_API_KEY=AIzaSyYourGooglePlacesAPIKeyHere
# Place ID của quán "Cẩm Cù House" tại Gia Nghĩa, Đắk Nông
GOOGLE_PLACE_ID=ChIJYourPlaceIdForCamCuHouseHere

# 4. Bảo Vệ Endpoint Cron Tự Động
# Bearer token bảo vệ /api/cron/sync-reviews từ Vercel Cron
CRON_SECRET=your_random_secure_cron_secret_token

# 5. Lưu Trữ Hình Ảnh (Vercel Blob Storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_read_write_token_here

# 6. Quan Sát & Đo Lường (Sentry & Vercel Analytics)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 7. Môi Trường Chạy
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://camcuhouse.online
NEXT_PUBLIC_ADMIN_URL=https://admin.camcuhouse.online
